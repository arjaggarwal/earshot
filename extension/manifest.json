{
  "manifest_version": 3,
  "name": "Earshot",
  "version": "0.5.9",
  "key": "",
  "description": "Speaker-tagged meeting transcripts, notes, screenshots and AI minutes for Google Meet, Zoom and Teams on the web, kept on your Mac.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "nativeMessaging",
    "notifications",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Earshot",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.zoom.us/*"
      ],
      "js": [
        "zoom/page-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*"
      ],
      "js": [
        "teams/page-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "meet/page-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.zoom.us/*",
        "https://meet.google.com/*"
      ],
      "js": [
        "content/page-layout.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://meet.google.com/*"
      ],
      "js": [
        "shared/transcript.js",
        "shared/markdown.js",
        "shared/languages.js",
        "content/bridge.js",
        "content/sidebar.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "zoom_web_client",
        "enabled": true,
        "path": "rules/zoom-web-client.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Show or hide the Earshot panel"
    },
    "take-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Screenshot what's being presented, or the meeting screen"
    },
    "focus-notes": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Jump to your notes"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "*://*.zoom.us/*",
        "https://meet.google.com/*",
        "https://teams.cloud.microsoft/*",
        "https://teams.live.com/*",
        "https://teams.microsoft.com/*"
      ]
    }
  ]
}
